# LINE連携の設定（.env にコピーして値を入れる。.env は Git 管理外）
# LINE Developers > プロバイダー > 「LINEログイン」チャネル
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 外部公開URL。LINE のコールバックURLは https が必要なため、ローカル検証では HTTPS トンネル（cloudflared / ngrok 等）のURLを入れる。
# コールバックURLは PUBLIC_ORIGIN + /api/auth/line/callback を LINE Developers に登録する。
PUBLIC_ORIGIN=
# LINEミニアプリ（LIFF）。同じLINEログインチャネルに追加した LIFF アプリの ID。エンドポイントURLは PUBLIC_ORIGIN。
LIFF_ID=
# 注文・出荷通知（任意）。Messaging API チャネルの長期チャネルアクセストークン。
LINE_MESSAGING_TOKEN=
# メールアドレス取得の権限を申請済みなら "profile openid email"
LINE_SCOPE=profile openid
# 追加で許可するホスト（カンマ区切り、例: example.trycloudflare.com）
ALLOWED_HOSTS=
