# データベース：未設定なら data/shop.sqlite（SQLite）。MySQL 8.0 を使う場合は接続先を指定する。
# DATABASE_URL=mysql://ユーザー:パスワード@127.0.0.1:3306/salon_station
DATABASE_URL=

# お客様の個人情報の暗号鍵（32バイトを base64 か16進数）。未設定のローカル版は data/encryption.key を自動で作る。
# 本番は必ず設定し、DBとは別の場所に控えを保管する（鍵をなくすと個人情報は復元できない）。
# 作り方：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# パスワード再設定メールの送信（未設定のローカル版は送信せず、DBの mail_outbox とサーバーの画面に保存する）
# SMTP_URL=smtps://ユーザー:パスワード@smtp.example.jp:465
SMTP_URL=
MAIL_FROM=SALON STATION <no-reply@example.jp>

# LINE連携の設定（.env にコピーして値を入れる。.env は Git 管理外）
# LINE Developers > プロバイダー > 「LINEログイン」チャネル
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 外部公開URL。LINE のコールバックURLは https が必要なため、ローカル検証では HTTPS トンネル（cloudflared / ngrok 等）のURLを入れる。
# コールバックURLは PUBLIC_ORIGIN + /api/auth/line/callback を LINE Developers に登録する。
PUBLIC_ORIGIN=
# LINEミニアプリ（LIFF）。同じLINEログインチャネルに追加した LIFF アプリの ID。エンドポイントURLは PUBLIC_ORIGIN。
LIFF_ID=
# 加盟店の発注画面の LIFF アプリ。エンドポイントURLは PUBLIC_ORIGIN/order.html。
LIFF_ID_ORDER=
# 注文・出荷通知（任意）。Messaging API チャネルの長期チャネルアクセストークン。
LINE_MESSAGING_TOKEN=
# メールアドレス取得の権限を申請済みなら "profile openid email"
LINE_SCOPE=profile openid
# 追加で許可するホスト（カンマ区切り、例: example.trycloudflare.com）
ALLOWED_HOSTS=
# トンネル・リバースプロキシ配下では 1（ログイン試行制限で X-Forwarded-For の接続元IPを使う）
TRUST_PROXY=
